# 1. Configurações Globais do Servidor Backend
PORT=8080
ENV=development
JWT_SECRET=portocercado2_super_secret_key_2026

# 2. Configurações do Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=portocercado2
DB_PASSWORD=portocercado2_pass
DB_NAME=portocercado2_db

# 3. Configurações de Cache Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 4. Configurações do Frontend (Vite)
VITE_API_URL=http://localhost:8088

# 5. Configuração da API OpenRouter AI (Redação de Notícias e Assistente IA)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
